{
  "app": "customer-service",
  "version": "1",
  "origins": [
    "http://127.0.0.1:8000"
  ],
  "routes": [
    "/",
    "/customers",
    "/customers/C-[0-9]+",
    "/customers/C-[0-9]+/edit",
    "/customers/C-[0-9]+/review",
    "/save",
    "/confirmation/UPD-[A-F0-9]+",
    "/restore",
    "/accounts",
    "/activity",
    "/accounts/search",
    "/accounts/AC-[0-9]+",
    "/cards",
    "/cards/search",
    "/cards/review",
    "/cards/save",
    "/cards/confirmation/CRD-[A-F0-9]+"
  ],
  "allowed_actions": [
    "click",
    "fill",
    "read",
    "check"
  ],
  "risky_targets": [
    "Save address",
    "Freeze card",
    "Unfreeze card"
  ],
  "automated_post_routes": [
    "/customers/C-[0-9]+/review",
    "/save",
    "/cards/review",
    "/cards/save"
  ],
  "risky_post_routes": [
    "/save",
    "/cards/save"
  ],
  "conditions": [
    {
      "text": "Customer not found",
      "category": "business"
    },
    {
      "text": "Invalid address",
      "category": "business"
    },
    {
      "text": "Record changed during review",
      "category": "business"
    },
    {
      "text": "Permission denied",
      "category": "failure"
    },
    {
      "text": "Session expired",
      "category": "intervene"
    },
    {
      "text": "Temporary load failure",
      "category": "recover",
      "recovery": {
        "kind": "click",
        "target": {
          "by": "role",
          "role": "link",
          "name": "Retry search"
        },
        "reason": "Retry known transient read failure"
      }
    },
    {
      "text": "Save result uncertain",
      "category": "recover",
      "recovery": {
        "kind": "click",
        "target": {
          "by": "role",
          "role": "link",
          "name": "Check saved result"
        },
        "reason": "Reconcile saved state without resubmitting"
      }
    },
    {
      "text": "Account not found",
      "category": "business"
    },
    {
      "text": "Card not found",
      "category": "business"
    },
    {
      "text": "Card already in requested state",
      "category": "business"
    }
  ]
}
