# Model provider: ollama or groq. Restart the backend after changes.
LLM_PROVIDER=ollama
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_URL=http://127.0.0.1:11434
# Application request budget (UTC day), not a provider billing limit.
LLM_DAILY_REQUEST_LIMIT=100
# Generated by start.ps1 or python -m demo.setup when using Docker.
DEMO_DB_PASSWORD=
